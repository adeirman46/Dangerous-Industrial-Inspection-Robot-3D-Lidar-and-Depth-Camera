<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Intel RealSense D435-style depth camera macro -->
  <xacro:macro name="depth_camera" params="parent_link camera_name:='depth_camera'">
    
    <!-- Camera properties -->
    <xacro:property name="camera_width" value="0.090"/>
    <xacro:property name="camera_height" value="0.025"/>
    <xacro:property name="camera_depth" value="0.025"/>
    <xacro:property name="camera_mass" value="0.072"/>
    
    <!-- Camera mount position - front of robot body -->
    <xacro:property name="camera_x" value="0.25"/>
    <xacro:property name="camera_y" value="0.0"/>
    <xacro:property name="camera_z" value="0.05"/>
    
    <!-- Camera joint -->
    <joint name="${camera_name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${camera_name}_link"/>
      <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
    </joint>
    
    <!-- Camera body link -->
    <link name="${camera_name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_depth} ${camera_width} ${camera_height}"/>
        </geometry>
        <material name="camera_gray">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_depth} ${camera_width} ${camera_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${camera_mass}"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    
    <!-- RGB Camera optical frame -->
    <joint name="${camera_name}_color_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    
    <link name="${camera_name}_color_optical_frame"/>
    
    <!-- Depth sensor optical frame -->
    <joint name="${camera_name}_depth_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_depth_optical_frame"/>
      <origin xyz="0.01 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    
    <link name="${camera_name}_depth_optical_frame"/>
    
    <!-- Gazebo depth camera plugin -->
    <gazebo reference="${camera_name}_link">
      <sensor name="${camera_name}" type="depth">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>  <!-- 60 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera>
            <output>depths</output>
          </depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        
        <plugin name="${camera_name}_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>${camera_name}/image_raw:=${camera_name}/color/image_raw</remapping>
            <remapping>${camera_name}/depth/image_raw:=${camera_name}/depth/image_raw</remapping>
            <remapping>${camera_name}/camera_info:=${camera_name}/color/camera_info</remapping>
            <remapping>${camera_name}/depth/camera_info:=${camera_name}/depth/camera_info</remapping>
            <remapping>${camera_name}/points:=${camera_name}/depth/points</remapping>
          </ros>
          
          <camera_name>${camera_name}</camera_name>
          <frame_name>${camera_name}_depth_optical_frame</frame_name>
          
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
    
  </xacro:macro>

</robot>
