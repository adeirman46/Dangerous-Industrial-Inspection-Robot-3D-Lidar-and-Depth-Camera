<?xml version="1.0"?>
<package format="3">
  <name>go2_bringup</name>
  <version>1.0.0</version>
  <description>Bringup package for Unitree Go2 robot with SLAM and factory world</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>go2_config</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>go2_control</exec_depend>
  <exec_depend>champ_bringup</exec_depend>
  <exec_depend>champ_gazebo</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
